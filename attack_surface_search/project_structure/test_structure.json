      "children": [
        {
          "type": "CLASS",
          "name": "GameConfiguration",
          "children": [
            {
              "type": "METHOD",
              "name": "levelMap",
              "content": [
                "if ( mapLouderType . equalsIgnoreCase ( \"generate\" ) )",
                "{",
                "MapGenerator mapGenerator = new MapGenerator ( );",
                "mapGenerator . loadLevelMap ( );",
                "return mapGenerator . getLevelMap ( );",
                "}",
                "if ( mapLouderType . equalsIgnoreCase ( \"file\" ) )",
                "{",
                "MapLoaderFromFile mapLoaderFromFile = tiledMapTileLayer ( absoluteFilePath );",
                "mapLoaderFromFile . loadLevelMap ( );",
                "return mapLoaderFromFile . getLevelMap ( );",
                "}",
                "return null;"
              ],
              "children": [
                {
                  "type": "ARGUMENT",
                  "name": "mapLouderType",
                  "children": []
                },
                {
                  "type": "ARGUMENT",
                  "name": "absoluteFilePath",
                  "children": []
                }
              ]
            },
            {
              "type": "METHOD",
              "name": "tiledMapTileLayer",
              "content": [
                "TiledMap tiledMap = new TmxMapLoader ( ) . load ( \"level . tmx\" );",
                "return getSingleLayer ( tiledMap );"
              ],
              "children": [
                {
                  "type": "ARGUMENT",
                  "name": "mapLouderType",
                  "children": []
                }
              ]
            }
          ]
        }
